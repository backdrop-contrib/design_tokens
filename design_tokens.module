<?php
/**
 * @file
 * Design Tokens module.
 *
 * Provides the infrastructure for CSS custom property-based theme
 * configuration. This module handles token discovery, config storage, and
 * CSS injection. Sub-modules register token types (color, font, etc.) and
 * provide the field UI for editing them.
 *
 * @see design_tokens_color.module
 * @see design_tokens_font.module
 */

/**
 * Implements hook_permission().
 */
function design_tokens_permission() {
  return array(
    'administer design tokens' => array(
      'title' => t('Administer Design Tokens'),
      'description' => t('Configure token values for themes that support Design Tokens.'),
    ),
  );
}

/**
 * Implements hook_menu().
 */
function design_tokens_menu() {
  $items['admin/appearance/tokens'] = array(
    'title' => 'Design Tokens',
    'description' => 'Configure tokens for themes that support Design Tokens.',
    'page callback' => 'design_tokens_overview_page',
    'access arguments' => array('administer design tokens'),
    'file' => 'design_tokens.admin.inc',
  );

  return $items;
}

/**
 * Implements hook_menu_alter().
 *
 * Registers a settings page for each theme that declares a tokens.inc file.
 */
function design_tokens_menu_alter(&$items) {
  foreach (design_tokens_get_supported_themes() as $theme_name => $theme) {
    $items['admin/appearance/tokens/' . $theme_name] = array(
      'title' => t('!theme tokens', array('!theme' => $theme->info['name'])),
      'page callback' => 'backdrop_get_form',
      'page arguments' => array('design_tokens_settings_form', $theme_name),
      'access arguments' => array('administer design tokens'),
      'file' => 'design_tokens.admin.inc',
      'file path' => backdrop_get_path('module', 'design_tokens'),
      'type' => MENU_NORMAL_ITEM,
    );
    $items['admin/appearance/tokens/' . $theme_name . '/reset'] = array(
      'title' => 'Reset all to defaults',
      'page callback' => 'backdrop_get_form',
      'page arguments' => array('design_tokens_reset_confirm_form', $theme_name),
      'access arguments' => array('administer design tokens'),
      'file' => 'design_tokens.admin.inc',
      'file path' => backdrop_get_path('module', 'design_tokens'),
      'type' => MENU_CALLBACK,
    );
  }
}

/**
 * Implements hook_js_alter().
 *
 * Loads the postMessage listener on all pages for themes that support Design
 * Tokens, so the preview iframe can receive and apply live token updates.
 * Uses hook_js_alter() because $theme is reliably set at this point.
 */
function design_tokens_js_alter(&$javascript) {
  global $theme;

  $info = design_tokens_load_info($theme);
  if (empty($info)) {
    return;
  }

  $path = backdrop_get_path('module', 'design_tokens') . '/js/design-tokens-preview-listener.js';
  $javascript[$path] = array(
    'data'        => $path,
    'type'        => 'file',
    'scope'       => 'footer',
    'group'       => JS_DEFAULT,
    'weight'      => 0,
    'every_page'  => TRUE,
    'preprocess'  => TRUE,
    'cache'       => TRUE,
    'defer'       => FALSE,
    'async'       => FALSE,
    'browsers'    => array(),
  );
}

/**
 * Implements hook_css_alter().
 *
 * Removes the theme's static variables file and injects saved token values
 * as inline CSS in its place. Doing both here ensures the injection happens
 * at the same point as CSS gathering, when $theme is reliably set.
 *
 * Themes declare which file to remove via a 'variables_file' key in tokens.inc:
 * @code
 * $info['variables_file'] = 'css/opera-variables.css';
 * @endcode
 * The value may also be an array of files, so a subtheme can add its own
 * static variables file to the one declared by its base theme. Each file is
 * looked up in the folder of every theme in the active theme's chain (base
 * themes first), and removed wherever it is found.
 */
function design_tokens_css_alter(&$css) {
  global $theme;

  $info = design_tokens_load_info($theme);
  if (empty($info)) {
    return;
  }

  // Remove the theme's static variables file.
  if (!empty($info['variables_file'])) {
    $variables_files = (array) $info['variables_file'];
    foreach (design_tokens_get_theme_chain($theme) as $chain_theme) {
      $theme_path = backdrop_get_path('theme', $chain_theme);
      foreach ($variables_files as $variables_file) {
        unset($css[$theme_path . '/' . $variables_file]);
      }
    }
  }

  // Inject token values as inline CSS to replace the removed file.
  $values = design_tokens_get_values($theme);
  if (empty($values)) {
    return;
  }

  $properties = array();
  foreach ($values as $token_name => $value) {
    $token_name = preg_replace('/[^a-zA-Z0-9_-]/', '', $token_name);
    $value = str_replace(array(';', '{', '}', '<', '>'), '', $value);
    if ($token_name && $value) {
      $properties[] = '  --' . $token_name . ': ' . $value . ';';
    }
  }

  if (empty($properties)) {
    return;
  }

  $css['design_tokens_vars'] = array(
    'data'        => ":root {\n" . implode("\n", $properties) . "\n}",
    'type'        => 'inline',
    'group'       => CSS_THEME,
    'weight'      => -100,
    'every_page'  => TRUE,
    'media'       => 'all',
    'preprocess'  => FALSE,
    'browsers'    => array('IE' => TRUE, '!IE' => TRUE),
  );
}

/**
 * Returns all registered token types provided by sub-modules.
 *
 * Each token type is provided by a sub-module implementing
 * hook_design_tokens_types(). The parent module uses this to delegate
 * field rendering to the appropriate sub-module.
 *
 * @return array
 *   Keyed by type machine name (e.g. 'color', 'font'). Each value is an
 *   array with keys:
 *   - 'label': Human-readable type name.
 *   - 'field callback': Function to call to build the form element.
 */
function design_tokens_get_types() {
  $types = &backdrop_static(__FUNCTION__);
  if (!isset($types)) {
    $types = module_invoke_all('design_tokens_types');
  }
  return $types;
}

/**
 * Returns a theme and its base themes, base themes first.
 *
 * @param string $theme_name
 *   The machine name of the theme.
 *
 * @return array
 *   Theme machine names, from the root base theme down to $theme_name. Base
 *   themes that are missing from the system are skipped.
 */
function design_tokens_get_theme_chain($theme_name) {
  $themes = list_themes();
  $chain = array();

  while (isset($themes[$theme_name]) && !in_array($theme_name, $chain)) {
    array_unshift($chain, $theme_name);
    $theme_name = isset($themes[$theme_name]->info['base theme']) ? $themes[$theme_name]->info['base theme'] : NULL;
  }

  return $chain;
}

/**
 * Loads the tokens.inc info array for a given theme.
 *
 * @param string $theme_name
 *   The machine name of the theme.
 *
 * @return array|false
 *   The $info array from tokens.inc, or FALSE if not found.
 */
function design_tokens_load_info($theme_name) {
  $cache = &backdrop_static(__FUNCTION__, array());

  if (isset($cache[$theme_name])) {
    return $cache[$theme_name];
  }

  $themes = list_themes();
  if (empty($themes[$theme_name])) {
    $cache[$theme_name] = FALSE;
    return FALSE;
  }

  // Use the theme's own tokens.inc, or fall back to the nearest base theme
  // that has one, so a subtheme inherits its base theme's token definitions.
  $chain = design_tokens_get_theme_chain($theme_name);
  $owner_theme = NULL;
  foreach (array_reverse($chain) as $chain_theme) {
    $chain_file = backdrop_get_path('theme', $chain_theme) . '/tokens.inc';
    if (file_exists($chain_file)) {
      $owner_theme = $chain_theme;
      $tokens_file = $chain_file;
      break;
    }
  }

  if (!$owner_theme) {
    $cache[$theme_name] = FALSE;
    return FALSE;
  }

  $info = array();
  include $tokens_file;
  $info['owner_theme'] = $owner_theme;

  // Remember the defaults written in tokens.inc, so defaults that alter hooks
  // change can be told apart from them later.
  $file_defaults = array();
  if (!empty($info['tokens'])) {
    foreach ($info['tokens'] as $token_name => $token) {
      $file_defaults[$token_name] = isset($token['default']) ? $token['default'] : NULL;
    }
  }

  // Call module alter hooks and the active theme's alter (if any).
  backdrop_alter('design_tokens_info', $info, $theme_name);

  // If the target theme is not the currently active theme (e.g., when viewing
  // the admin UI under a different admin theme), backdrop_alter() will not
  // have called the target theme's implementation. Include its template.php
  // and call the function directly.
  // The theme's base themes are included too, base themes first.
  global $theme;
  if ($theme !== $theme_name) {
    foreach ($chain as $chain_theme) {
      $template_file = BACKDROP_ROOT . '/' . backdrop_get_path('theme', $chain_theme) . '/template.php';
      if (file_exists($template_file)) {
        include_once $template_file;
      }
      $alter_function = $chain_theme . '_design_tokens_info_alter';
      if (function_exists($alter_function)) {
        $alter_function($info, $theme_name);
      }
    }
  }

  design_tokens_apply_variables_defaults($info, $theme_name, $file_defaults);

  $cache[$theme_name] = $info;
  return $info;
}

/**
 * Takes token defaults from the theme's static variables file(s).
 *
 * The values in the variables file are what visitors see when Design Tokens
 * is not active, so they are the theme's real defaults. Reading them here
 * means a theme writes each value once, in CSS, instead of repeating it as
 * 'default' in tokens.inc.
 *
 * Order of precedence, lowest first:
 * - 'default' in tokens.inc.
 * - The value in the variables file(s). Files are read for every theme in the
 *   chain, base themes first, so a subtheme's file overrides its base theme's.
 * - A default set or changed by a hook_design_tokens_info_alter()
 *   implementation.
 *
 * A value calculated in CSS (anything with a parenthesis, such as color-mix()
 * or var()) is kept as the default and the token is marked 'calculated'. The
 * module then injects the calculation itself, so the value keeps following
 * the tokens it is calculated from until someone sets their own value; a
 * color field shows it as "Automatic".
 *
 * A scheme without a 'tokens' key gets the final defaults of the tokens the
 * other schemes set (or of all color tokens, if no scheme lists any), so a
 * theme's default scheme doesn't have to repeat them.
 *
 * @param array $info
 *   The token info array, after alter hooks have run.
 * @param string $theme_name
 *   The machine name of the theme.
 * @param array $file_defaults
 *   The 'default' of each token as written in tokens.inc (NULL if none),
 *   keyed by token name.
 */
function design_tokens_apply_variables_defaults(array &$info, $theme_name, array $file_defaults) {
  if (empty($info['tokens'])) {
    return;
  }

  $css_values = array();
  $css_sources = array();
  if (!empty($info['variables_file'])) {
    $css_values = design_tokens_read_variables_files($theme_name, (array) $info['variables_file'], $css_sources);
  }

  foreach ($info['tokens'] as $token_name => $token) {
    $current = isset($token['default']) ? $token['default'] : NULL;
    $original = array_key_exists($token_name, $file_defaults) ? $file_defaults[$token_name] : NULL;
    // A token added by an alter hook, or a default an alter hook changed,
    // stays as the hook set it, unless the hook left it empty.
    $altered = !array_key_exists($token_name, $file_defaults) || $current !== $original;

    // Record where the default comes from, for the settings page. A default
    // set by an alter hook has no file to point to.
    unset($info['tokens'][$token_name]['default_source']);
    if (!$altered && $current !== NULL) {
      $info['tokens'][$token_name]['default_source'] = array(
        'theme' => $info['owner_theme'],
        'file' => 'tokens.inc',
      );
    }

    if (isset($css_values[$token_name]) && (!$altered || $current === NULL)) {
      $info['tokens'][$token_name]['default'] = $css_values[$token_name];
      $info['tokens'][$token_name]['default_source'] = $css_sources[$token_name];
    }
    $default = isset($info['tokens'][$token_name]['default']) ? $info['tokens'][$token_name]['default'] : '';
    $info['tokens'][$token_name]['calculated'] = design_tokens_is_calculated($default);
  }

  // A scheme without 'tokens' uses the defaults of the tokens the theme's
  // other schemes set, so it switches the same colors back. If no other
  // scheme lists tokens, it uses the defaults of all color tokens.
  if (!empty($info['schemes'])) {
    $scheme_tokens = array();
    foreach ($info['schemes'] as $scheme) {
      if (isset($scheme['tokens'])) {
        $scheme_tokens += $scheme['tokens'];
      }
    }
    $defaults = array();
    foreach ($info['tokens'] as $token_name => $token) {
      if (!isset($token['default'])) {
        continue;
      }
      if ($scheme_tokens ? isset($scheme_tokens[$token_name]) : (isset($token['type']) && $token['type'] === 'color')) {
        $defaults[$token_name] = $token['default'];
      }
    }
    foreach ($info['schemes'] as $scheme_key => $scheme) {
      if (!isset($scheme['tokens'])) {
        $info['schemes'][$scheme_key]['tokens'] = $defaults;
      }
    }
  }
}

/**
 * Tells whether a token value is a CSS calculation rather than a plain value.
 *
 * @param string $value
 *   A token value, e.g. '#6e0e0a' or 'color-mix(in srgb, var(--x) 5%, white)'.
 *
 * @return bool
 *   TRUE for values such as color-mix(), var() or calc().
 */
function design_tokens_is_calculated($value) {
  return is_string($value) && strpos($value, '(') !== FALSE;
}

/**
 * Reads CSS custom properties from a theme's static variables file(s).
 *
 * @param string $theme_name
 *   The machine name of the theme.
 * @param array $variables_files
 *   File paths relative to a theme folder, as in tokens.inc 'variables_file'.
 * @param array $sources
 *   (optional) Filled with where each value came from, keyed by property
 *   name: an array with 'theme' (machine name) and 'file' (path relative to
 *   that theme's folder).
 *
 * @return array
 *   Values keyed by property name without the leading "--". Each file is
 *   looked up in every theme of the chain, base themes first; later files
 *   override earlier ones.
 */
function design_tokens_read_variables_files($theme_name, array $variables_files, &$sources = NULL) {
  $values = array();
  $sources = array();
  foreach (design_tokens_get_theme_chain($theme_name) as $chain_theme) {
    $theme_path = BACKDROP_ROOT . '/' . backdrop_get_path('theme', $chain_theme);
    foreach ($variables_files as $variables_file) {
      $path = $theme_path . '/' . $variables_file;
      if (is_file($path)) {
        foreach (design_tokens_parse_variables(file_get_contents($path)) as $name => $value) {
          $values[$name] = $value;
          $sources[$name] = array('theme' => $chain_theme, 'file' => $variables_file);
        }
      }
    }
  }
  return $values;
}

/**
 * Parses the custom properties in the :root {} blocks of a CSS string.
 *
 * @param string $css
 *   CSS source.
 *
 * @return array
 *   Values keyed by property name without the leading "--".
 */
function design_tokens_parse_variables($css) {
  $values = array();
  $css = preg_replace('!/\*.*?\*/!s', '', $css);
  if (preg_match_all('/:root\s*\{([^}]*)\}/', $css, $blocks)) {
    foreach ($blocks[1] as $block) {
      preg_match_all('/--([a-zA-Z0-9_-]+)\s*:\s*([^;]+);/', $block, $matches, PREG_SET_ORDER);
      foreach ($matches as $match) {
        $values[$match[1]] = trim($match[2]);
      }
    }
  }
  return $values;
}

/**
 * Implements hook_themes_enabled().
 *
 * Saves each newly enabled theme's token defaults as its configuration, the
 * same way a module's default config is installed: later changes to the
 * theme's defaults then only reach new sites, not existing ones.
 */
function design_tokens_themes_enabled($theme_list) {
  foreach ($theme_list as $theme_name) {
    design_tokens_save_initial_values($theme_name);
  }
}

/**
 * Saves a theme's default token values as config, if it has none yet.
 *
 * A theme that ships its own config/theme.tokens.<theme>.json keeps that file
 * (core installs it before hook_themes_enabled() runs), so this does nothing
 * for it.
 *
 * @param string $theme_name
 *   The machine name of the theme.
 */
function design_tokens_save_initial_values($theme_name) {
  $config = config('theme.tokens.' . $theme_name);
  if (!$config->isNew()) {
    return;
  }
  $info = design_tokens_load_info($theme_name);
  if (empty($info['tokens'])) {
    return;
  }
  $config->set('tokens', design_tokens_get_values($theme_name));
  if (isset($info['schemes']['default'])) {
    $config->set('scheme', 'default');
  }
  $config->save();
}

/**
 * Returns all enabled themes that have a tokens.inc file.
 *
 * @return array
 *   Keyed by theme machine name, values are theme objects.
 */
function design_tokens_get_supported_themes() {
  $cache = &backdrop_static(__FUNCTION__);

  if (isset($cache)) {
    return $cache;
  }

  $cache = array();
  foreach (list_themes() as $name => $theme) {
    if ($theme->status && design_tokens_load_info($name) !== FALSE) {
      $cache[$name] = $theme;
    }
  }

  return $cache;
}

/**
 * Returns the current token values for a theme.
 *
 * Merges defaults from tokens.inc with any saved config values.
 *
 * @param string $theme_name
 *   The machine name of the theme.
 *
 * @return array
 *   Keyed by token name, values are CSS values (e.g. hex color strings).
 */
function design_tokens_get_values($theme_name) {
  $info = design_tokens_load_info($theme_name);
  if (empty($info['tokens'])) {
    return array();
  }

  $defaults = array();
  foreach ($info['tokens'] as $token_name => $token) {
    if (isset($token['default'])) {
      $defaults[$token_name] = $token['default'];
    }
  }

  $config = config('theme.tokens.' . $theme_name);
  $saved = $config->get('tokens');
  if (!is_array($saved)) {
    $saved = array();
  }

  return array_merge($defaults, $saved);
}

/**
 * Saves token values for a theme.
 *
 * @param string $theme_name
 *   The machine name of the theme.
 * @param array $values
 *   Keyed by token name, values are CSS values.
 */
function design_tokens_save_values($theme_name, array $values) {
  $config = config('theme.tokens.' . $theme_name);
  $config->set('tokens', $values);
  $config->save();
}

/**
 * Saves the active preset scheme name for a theme.
 *
 * @param string $theme_name
 *   The machine name of the theme.
 * @param string $scheme
 *   The scheme key (e.g. 'plume'), or empty string for custom/no scheme.
 */
function design_tokens_save_scheme($theme_name, $scheme) {
  $config = config('theme.tokens.' . $theme_name);
  $config->set('scheme', $scheme);
  $config->save();
}

/**
 * Returns the saved active preset scheme key for a theme.
 *
 * @param string $theme_name
 *   The machine name of the theme.
 *
 * @return string
 *   The saved scheme key, or empty string if none saved.
 */
function design_tokens_get_scheme($theme_name) {
  $scheme = config('theme.tokens.' . $theme_name)->get('scheme');
  return is_string($scheme) ? $scheme : '';
}
